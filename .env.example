# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=energy_forecasting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://energy_user:change_me@localhost:5432/energy_forecasting

MODEL_PATH=backend/models/lightgbm_energy_forecaster.joblib
ARTIFACTS_DIR=backend/artifacts
HISTORY_DATA_PATH=data/energy_consumption_hourly.csv

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Neon Object Storage -----------------------------------------------------
# Credentials are NOT derived from DATABASE_URL — they are separate S3 keys
# issued per-branch by Neon. Obtain them from:
#   Neon Console → your project → Object Storage → Credentials
# Or run:  neon env pull  (Neon CLI) to auto-populate these in .env.local
# Set USE_NEON_STORAGE=false to skip bucket sync for non-Neon deployments.
USE_NEON_STORAGE=true
# Bucket name inside your Neon project. Created automatically on first startup.
NEON_BUCKET_NAME=energy-forecasting-artifacts
NEON_S3_ACCESS_KEY_ID=your_neon_s3_access_key
NEON_S3_SECRET_ACCESS_KEY=your_neon_s3_secret_key
NEON_S3_ENDPOINT_URL=https://s3.<region>.aws.neon.tech
# Optional: auto-parsed from NEON_S3_ENDPOINT_URL if left blank
NEON_S3_REGION=

# --- Docker Compose only ---
# Use a URL-safe POSTGRES_PASSWORD (no @ : / ? #): compose builds DATABASE_URL from it.
# Model/artifact/history paths above are for running the backend outside Docker;
# compose mounts backend/models, backend/artifacts and data/ into the container instead.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# VITE_API_BASE_URL is baked into the frontend image at build time (rebuild after changing it).

# --- MLflow (optional; training-side only) ---
MLFLOW_PORT=5000
# Leave empty in Colab to log to a local ./mlruns folder.
MLFLOW_TRACKING_URI=
