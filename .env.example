# Copy to .env and fill in. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=energy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=energy_forecasting
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://energy_user:change_me@localhost:5432/energy_forecasting

MODEL_PATH=backend/models/lightgbm_energy_forecaster.joblib
ARTIFACTS_DIR=backend/artifacts
HISTORY_DATA_PATH=data/energy_consumption_hourly.csv

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Docker Compose only ---
# Use a URL-safe POSTGRES_PASSWORD (no @ : / ? #): compose builds DATABASE_URL from it.
# Model/artifact/history paths above are for running the backend outside Docker;
# compose mounts backend/models, backend/artifacts and data/ into the container instead.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# VITE_API_BASE_URL is baked into the frontend image at build time (rebuild after changing it).

# --- MLflow (optional; training-side only) ---
MLFLOW_PORT=5000
# Leave empty in Colab to log to a local ./mlruns folder.
MLFLOW_TRACKING_URI=
